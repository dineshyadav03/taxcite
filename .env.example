# Required: embeddings run via Voyage AI's hosted embedding API (free
# tier, 200M tokens, no credit card). Get a free key at
# https://www.voyageai.com
VOYAGE_API_KEY=

# Required for generation: Groq's free-tier hosted API.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback if GROQ_API_KEY is unset: fully local via Ollama.
OLLAMA_MODEL=llama3.2:3b
